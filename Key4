local function GetCurrency()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return nil, nil end
    local commonNames = {"Cash","Coins","Money","Gold","Gems","Currency","Bucks","Diamonds"}
    for _, name in ipairs(commonNames) do
        local stat = ls:FindFirstChild(name)
        if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then return stat.Value, name end
    end
    for _, child in pairs(ls:GetChildren()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") then return child.Value, child.Name end
    end
    return nil, nil
end

local function SortTraderItems(items)
    local sorted = {}
    for _, it in ipairs(items) do table.insert(sorted, it) end
    if TraderSettings.SortMode == "StockAsc" then
        table.sort(sorted, function(a,b) return (a.Stock or 0) < (b.Stock or 0) end)
    elseif TraderSettings.SortMode == "PriceDesc" then
        table.sort(sorted, function(a,b) return (a.Price or 0) > (b.Price or 0) end)
    end
    return sorted
end

local function BuyItemUnits(item)
    while ActiveBuyThreads >= TraderSettings.MaxConcurrentItems do
        task.wait(0.03)
        if not TraderSettings.AutoBuyEnabled then return end
    end
    ActiveBuyThreads = ActiveBuyThreads + 1
    local bought = 0
    local unitDelay = TraderSettings.TurboMode and 0 or TraderSettings.UnitDelay
    for i = 1, (item.Stock or 0) do
        if not TraderSettings.AutoBuyEnabled then break end
        if TraderSettings.BudgetLimit and item.Price then
            local currentMoney = select(1, GetCurrency())
            if currentMoney and currentMoney < item.Price then break end
        end
        local ok = pcall(function() BuyTraderRemote:FireServer(item.Name) end)
        if ok then
            bought = bought + 1
            TraderBought = TraderBought + 1
            if item.Price then TraderSpent = TraderSpent + item.Price end
        end
        task.wait(unitDelay > 0 and unitDelay or nil)
    end
    if bought > 0 then AddLog(string.format("🛒 %s x%d", item.Name, bought), Color3.fromRGB(100,255,100)) end
    ActiveBuyThreads = ActiveBuyThreads - 1
end

local function AutoBuyItems()
    if not TraderAvailable then return end
    if isBuyingTrader or not TraderSettings.AutoBuyEnabled then return end
    isBuyingTrader = true
    local ok, stockData = pcall(function() return GetStock:InvokeServer() end)
    if ok and stockData and stockData.Items then
        ItemListCache = stockData.Items
        for _, item in ipairs(stockData.Items) do
            if ItemEnabled[item.Name] == nil then ItemEnabled[item.Name] = true end
        end
        for _, item in ipairs(SortTraderItems(stockData.Items)) do
            if not TraderSettings.AutoBuyEnabled then break end
            if (ItemEnabled[item.Name] ~= false) and item.Stock and item.Stock > 0 then
                task.spawn(BuyItemUnits, item)
            end
        end
    else
        AddLog("⚠️ ดึง Stock ไม่สำเร็จ", Color3.fromRGB(255,150,50))
    end
    isBuyingTrader = false
end

if TraderAvailable then
    workspace:GetAttributeChangedSignal("TraderEventActive"):Connect(function()
        if workspace:GetAttribute("TraderEventActive") == true and TraderSettings.AutoBuyEnabled then
            task.spawn(function()
                task.wait(1)
                while workspace:GetAttribute("TraderEventActive") == true and TraderSettings.AutoBuyEnabled do
                    AutoBuyItems()
                    task.wait(TraderSettings.RecheckInterval)
                end
            end)
        end
    end)
end

-- ==========================================
-- 🎲 ฟังก์ชัน Roll
-- ==========================================
local function CheckCharacter(charName) return CharacterEnabled[charName] == true end
local function CheckMutation(mutName)
    local currentMut = (mutName == "" or not mutName) and "None" or mutName
    return MutationEnabled[currentMut] == true
end

if RollAvailable then
    RollRemote.OnClientEvent:Connect(function(player, base, rollData, unk, rollId)
        if player ~= LocalPlayer or not rollData then return end
        if isProcessingRoll then return end
        isProcessingRoll = true
        local boughtThisRoll = 0
        for slotIndex, charInfo in pairs(rollData) do
            if boughtThisRoll >= RollSettings.MaxBuysPerRoll then break end
            if not RollSettings.BuyAllMatches and boughtThisRoll >= 1 then break end
            local name = charInfo.Name or "Unknown"
            local mutation = charInfo.Mutation or ""
            local displayMut = (mutation ~= "" and mutation or "None")
            if CheckCharacter(name) and CheckMutation(mutation) then
                local ok = pcall(function() BuyRollRemote:FireServer(rollId, slotIndex) end)
                if ok then
                    boughtThisRoll = boughtThisRoll + 1
                    RollBought = RollBought + 1
                    AddLog(string.format("🎲 %s [%s]", name, displayMut), Color3.fromRGB(150,200,255))
                end
            end
        end
        isProcessingRoll = false
    end)
end

task.spawn(function()
    while true do
        task.wait(RollSettings.TurboMode and 0.05 or RollSettings.RollDelay)
        if RollSettings.AutoRoll and RollAvailable then
            RollCount = RollCount + 1
            pcall(function() RollRemote:FireServer() end)
        end
    end
end)

