-- ==========================================
-- 🚀 Anime To Fight - Complete Auto Roll & Buy Script
-- ==========================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- ------------------------------------------
-- ⚙️ ตั้งค่าระบบ (ปรับแต่งตามต้องการ)
-- ------------------------------------------
local RollSettings = {
    AutoRoll = false,          -- เปิด/ปิด สุ่มอัตโนมัติ (ปรับใน UI ได้)
    MaxBuysPerRoll = 3,        -- ซื้อได้สูงสุดกี่ตัวต่อการสุ่ม 1 ครั้ง
    BuyAllMatches = true,      -- ซื้อทุกตัวที่ตรงเงื่อนไข (ถ้า false จะซื้อแค่ตัวแรกที่พบ)
    WalkWaitTime = 0.5         -- หน่วงเวลารอระหว่างรอบ
}

local RollCount = 0
local RollBought = 0
local isWaitingWalk = false

-- 🎯 รายชื่อตัวละครที่ต้องการให้ซื้ออัตโนมัติ (ใส่ชื่อ = true)
local CharacterEnabled = {
    ["Shinra"] = true,
    ["Itadori"] = true,
    ["Saitama"] = true,
    ["Goku"] = true,
    ["Naruto"] = true,
}

-- 🧬 รายชื่อ Mutation ที่ต้องการซื้อ
local MutationEnabled = {
    ["None"] = true,
    ["Shiny"] = true,
    ["Golden"] = true,
    ["Shadow"] = true,
}

-- 🎨 ข้อมูล Rarity สำหรับแสดงผล Log
local RarityData = {
    ["Common"] = { color = Color3.fromRGB(180, 180, 180), icon = "⚪" },
    ["Rare"] = { color = Color3.fromRGB(50, 150, 255), icon = "🔵" },
    ["Epic"] = { color = Color3.fromRGB(170, 0, 255), icon = "🟣" },
    ["Legendary"] = { color = Color3.fromRGB(255, 170, 0), icon = "🟡" },
    ["Mythic"] = { color = Color3.fromRGB(255, 50, 80), icon = "🔴" },
    ["Secret"] = { color = Color3.fromRGB(0, 255, 200), icon = "✨" },
    ["God"] = { color = Color3.fromRGB(255, 215, 0), icon = "👑" }
}

-- ------------------------------------------
-- 🔌 ค้นหา Remote ของเกม
-- ------------------------------------------
local RollRemote, BuyRollRemote

for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
    if desc:IsA("RemoteEvent") and desc.Name == "Roll" then
        RollRemote = desc
        if desc.Parent then 
            BuyRollRemote = desc.Parent:FindFirstChild("Buy") 
        end
        break
    end
end

local RollAvailable = (RollRemote ~= nil and BuyRollRemote ~= nil)

-- ------------------------------------------
-- 🖥️ ระบบสร้างหน้าต่าง UI Log ในเกม
-- ------------------------------------------
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoRollGui"
ScreenGui.ResetOnSpawn = false

pcall(function()
    if gethui then
        ScreenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = game:GetService("CoreGui")
    else
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end)

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 320, 0, 240)
Frame.Position = UDim2.new(0, 20, 0.4, 0)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local UICorner = Instance.new("UICorner", Frame)
UICorner.CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 35)
Title.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
Title.Text = "  🎲 Auto Roll System"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 16
Title.Parent = Frame
Instance.new("UICorner", Title)

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0, 95, 0, 25)
ToggleBtn.Position = UDim2.new(1, -105, 0, 5)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.Text = "Auto Roll: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 12
ToggleBtn.Parent = Title
Instance.new("UICorner", ToggleBtn)

ToggleBtn.MouseButton1Click:Connect(function()
    RollSettings.AutoRoll = not RollSettings.AutoRoll
    if RollSettings.AutoRoll then
        ToggleBtn.Text = "Auto Roll: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "Auto Roll: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

local LogScroll = Instance.new("ScrollingFrame")
LogScroll.Size = UDim2.new(1, -16, 1, -50)
LogScroll.Position = UDim2.new(0, 8, 0, 42)
LogScroll.BackgroundTransparency = 1
LogScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
LogScroll.ScrollBarThickness = 4
LogScroll.Parent = Frame

local UIList = Instance.new("UIListLayout")
UIList.Parent = LogScroll
UIList.SortOrder = Enum.SortOrder.LayoutOrder
UIList.Padding = UDim.new(0, 3)

UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    LogScroll.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y)
    LogScroll.CanvasPosition = Vector2.new(0, UIList.AbsoluteContentSize.Y)
end)

local function AddLog(msg, color)
    print("[AutoRoll] " .. msg)
    local LogLabel = Instance.new("TextLabel")
    LogLabel.Size = UDim2.new(1, 0, 0, 18)
    LogLabel.BackgroundTransparency = 1
    LogLabel.Text = " " .. msg
    LogLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    LogLabel.TextXAlignment = Enum.TextXAlignment.Left
    LogLabel.Font = Enum.Font.SourceSans
    LogLabel.TextSize = 14
    LogLabel.Parent = LogScroll
end

-- ------------------------------------------
-- 🎯 ฟังก์ชันตรวจสอบเงื่อนไข
-- ------------------------------------------
local function CheckCharacter(name)
    if not next(CharacterEnabled) then return true end
    return CharacterEnabled[name] == true
end

local function CheckMutation(mut)
    local m = (mut == "" or not mut) and "None" or mut
    if not next(MutationEnabled) then return true end
    return MutationEnabled[m] == true
end

-- ------------------------------------------
-- 🎲 รับข้อมูลจาก Server & ส่งคำสั่งซื้อ
-- ------------------------------------------
if RollAvailable then
    AddLog("✅ สคริปต์พร้อมใช้งาน! เชื่อมต่อ Remote สำเร็จ", Color3.fromRGB(100, 255, 100))
    
    -- รับโครงสร้างจริง: (player, statue, rolledCharacters, rollId, ...)
    RollRemote.OnClientEvent:Connect(function(player, statue, rolledCharacters, rollId, ...)
        if type(rolledCharacters) ~= "table" then return end

        local boughtThisRoll = 0
        
        for slotIndex, charInfo in pairs(rolledCharacters) do
            if type(charInfo) ~= "table" then continue end
            
            if boughtThisRoll >= RollSettings.MaxBuysPerRoll then break end
            if not RollSettings.BuyAllMatches and boughtThisRoll >= 1 then break end
            
            local name = charInfo.Name or charInfo.DisplayName or "Unknown"
            local mut = charInfo.Mutation or ""
            local rarityStr = charInfo.Rarity or "Unknown"
            
            -- ตรวจสอบว่าตรงกับรายชื่อที่เราเปิดให้ซื้อหรือไม่
            if CheckCharacter(name) and CheckMutation(mut) then
                boughtThisRoll = boughtThisRoll + 1
                RollBought = RollBought + 1
                
                -- หน่วงเวลา 0.5 วินาที แล้วยิงคำสั่งซื้อ
                task.delay(0.5, function()
                    local ok = pcall(function() 
                        BuyRollRemote:FireServer(rollId, slotIndex) 
                    end)
                    
                    if ok then
                        local rarInfo = RarityData[rarityStr] or {}
                        AddLog(string.format("%s ได้รับ: %s [%s] (%s)",
                            rarInfo.icon or "🔹", name,
                            mut ~= "" and mut or "None", rarityStr),
                            rarInfo.color or Color3.fromRGB(255, 255, 255))
                    end
                end)
            end
        end

        isWaitingWalk = true
        task.wait(RollSettings.WalkWaitTime)
        isWaitingWalk = false
    end)
else
    AddLog("❌ ไม่พบ Remote ตู้สุ่ม", Color3.fromRGB(255, 80, 80))
end

-- ------------------------------------------
-- 🔄 ลูปสั่งสุ่มอัตโนมัติ
-- ------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.5)
        if RollSettings.AutoRoll and RollAvailable and not isWaitingWalk then
            RollCount = RollCount + 1
            pcall(function() 
                RollRemote:FireServer() 
            end)
            task.wait(1.5)
        end
    end
end)
