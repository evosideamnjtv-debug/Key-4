local function FindRollButton()
    local rollObj = workspace:FindFirstChild("Roll", true)
        or workspace:FindFirstChild("RollButton", true)
    if not rollObj then return nil end

    local cd = rollObj:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then return cd end

    local btn = rollObj:FindFirstChild("Button")
    if btn then
        cd = btn:FindFirstChildWhichIsA("ClickDetector")
        if cd then return cd end
    end
    return nil
end

local function ClickRollButton()
    local cd = FindRollButton()
    if cd then
        pcall(function()
            local fireCD = fireclickdetector or (function(d) end)
            fireCD(cd)
        end)
        if not fireclickdetector and RollAvailable then
            pcall(function() RollRemote:FireServer() end)
        end
        return true
    elseif RollAvailable then
        pcall(function() RollRemote:FireServer() end)
        return true
    end
    return false
end

-- ==========================================
-- 🎲 Roll Logic
-- ==========================================
local function CheckCharacter(name) return CharacterEnabled[name]==true end
local function CheckMutation(mut)
    local m = (mut=="" or not mut) and "None" or mut
    return MutationEnabled[m]==true
end

if RollAvailable then
    RollRemote.OnClientEvent:Connect(function(player, base, rollData, unk, rollId)
        if player~=LocalPlayer or not rollData then return end

        local boughtThisRoll = 0
        for slotIndex, charInfo in pairs(rollData) do
            if boughtThisRoll >= RollSettings.MaxBuysPerRoll then break end
            if not RollSettings.BuyAllMatches and boughtThisRoll >= 1 then break end
            local name = charInfo.Name or "Unknown"
            local mut = charInfo.Mutation or ""
            if CheckCharacter(name) and CheckMutation(mut) then
                local ok = pcall(function() BuyRollRemote:FireServer(rollId, slotIndex) end)
                if ok then
                    boughtThisRoll = boughtThisRoll + 1
                    RollBought = RollBought + 1
                    local rarity = GetRarity(name)
                    local rarInfo = RarityData[rarity] or {}
                    AddLog(string.format("%s %s [%s] — %s",
                        rarInfo.icon or "?", name,
                        mut~="" and mut or "None", rarity),
                        rarInfo.color or Color3.new(1,1,1))
                end
            end
        end

        isWaitingWalk = true
        task.wait(RollSettings.WalkWaitTime)
        isWaitingWalk = false
    end)
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if RollSettings.AutoRoll and RollAvailable and not isWaitingWalk then
            RollCount = RollCount + 1
            local clicked = ClickRollButton()
            if not clicked then
                task.wait(1)
            else
                task.wait(0.5)
            end
        end
    end
end)

