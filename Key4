-- ==========================================
-- 🛡️ Anti-AFK (เปิด-ปิดแชท - วิธีที่ยืนยันแล้วว่าได้ผล)
-- ==========================================
local function PreventAFK()
    lastAFKAction = os.clock()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Slash, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Slash, false, game)
        task.wait(0.15)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
    end)
end
LocalPlayer.Idled:Connect(function() if AFKSettings.Enabled then PreventAFK() end end)
task.spawn(function()
    while true do
        task.wait(AFKSettings.ProactiveInterval)
        if AFKSettings.Enabled then PreventAFK() end
    end
end)

-- ==========================================
-- 💾 Persistent Save/Load
-- ==========================================
local function SaveSettings()
    if not HasFileSystem then return end
    pcall(function()
        writefile(SaveFileName, HttpService:JSONEncode({
            ItemEnabled = ItemEnabled, CharacterEnabled = CharacterEnabled, MutationEnabled = MutationEnabled,
            TraderSortMode = TraderSettings.SortMode, TraderTurbo = TraderSettings.TurboMode,
            TraderMaxConcurrent = TraderSettings.MaxConcurrentItems,
            RollDelay = RollSettings.RollDelay, RollTurbo = RollSettings.TurboMode, RollBuyAll = RollSettings.BuyAllMatches,
            AFKEnabled = AFKSettings.Enabled,
        }))
    end)
end

local function LoadSettings()
    if not HasFileSystem then return end
    local ok, data = pcall(function()
        if isfile(SaveFileName) then return HttpService:JSONDecode(readfile(SaveFileName)) end
        return nil
    end)
    if ok and data then
        if data.ItemEnabled then for k,v in pairs(data.ItemEnabled) do ItemEnabled[k]=v end end
        if data.CharacterEnabled then for k,v in pairs(data.CharacterEnabled) do CharacterEnabled[k]=v end end
        if data.MutationEnabled then for k,v in pairs(data.MutationEnabled) do MutationEnabled[k]=v end end
        if data.TraderSortMode then TraderSettings.SortMode = data.TraderSortMode end
        if data.TraderTurbo ~= nil then TraderSettings.TurboMode = data.TraderTurbo end
        if data.TraderMaxConcurrent then TraderSettings.MaxConcurrentItems = data.TraderMaxConcurrent end
        if data.RollDelay then RollSettings.RollDelay = data.RollDelay end
        if data.RollTurbo ~= nil then RollSettings.TurboMode = data.RollTurbo end
        if data.RollBuyAll ~= nil then RollSettings.BuyAllMatches = data.RollBuyAll end
        if data.AFKEnabled ~= nil then AFKSettings.Enabled = data.AFKEnabled end
        print("📂 โหลดการตั้งค่าเดิมสำเร็จ")
    end
end
