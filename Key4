        DashTraderCard.Text = string.format("🛒 Trader Bot\n%s | %s",
            TraderSettings.AutoBuyEnabled and "🟢 กำลังทำงาน" or "🔴 ปิดอยู่",
            TraderAvailable and "พบระบบในเกม ✅" or "ไม่พบระบบในเกม ⚠️")
        DashRollCard.Text = string.format("🎲 Roll Bot\n%s | %s",
            RollSettings.AutoRoll and "🟢 กำลังทำงาน" or "🔴 ปิดอยู่",
            RollAvailable and "พบระบบในเกม ✅" or "ไม่พบระบบในเกม ⚠️")
        DashAFKCard.Text = string.format("🛡️ AFK: %s | รวมซื้อ: %d ชิ้น (Trader) + %d ตัว (Roll)",
            AFKSettings.Enabled and "ON" or "OFF", TraderBought, RollBought)

        if #PurchaseLog ~= lastLogCount then
            RefreshLogUI()
            lastLogCount = #PurchaseLog
        end
    end
end)

if TraderAvailable then
    task.spawn(function()
        task.wait(2)
        pcall(function()
            local stockData = GetStock:InvokeServer()
            if stockData and stockData.Items then
                ItemListCache = stockData.Items
                for _, item in ipairs(stockData.Items) do
                    if ItemEnabled[item.Name] == nil then ItemEnabled[item.Name] = true end
                end
                RefreshItemListUI()
            end
        end)
    end)
end

