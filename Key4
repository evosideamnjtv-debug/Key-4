local function GetCurrency()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return nil, nil end
    for _, name in ipairs({"Cash","Coins","Money","Gold","Gems","Currency","Bucks","Diamonds"}) do
        local s = ls:FindFirstChild(name)
        if s and (s:IsA("IntValue") or s:IsA("NumberValue")) then return s.Value, name end
    end
    for _, c in pairs(ls:GetChildren()) do
        if c:IsA("IntValue") or c:IsA("NumberValue") then return c.Value, c.Name end
    end
    return nil, nil
end

local function SortTraderItems(items)
    local sorted = {}
    for _, it in ipairs(items) do table.insert(sorted, it) end
    if TraderSettings.SortMode=="StockAsc" then
        table.sort(sorted, function(a,b) return (a.Stock or 0)<(b.Stock or 0) end)
    elseif TraderSettings.SortMode=="PriceDesc" then
        table.sort(sorted, function(a,b) return (a.Price or 0)>(b.Price or 0) end)
    end
    return sorted
end

local function BuyItemUnits(item)
    while ActiveBuyThreads >= TraderSettings.MaxConcurrentItems do
        task.wait(0.03)
        if not TraderSettings.AutoBuyEnabled then return end
    end
    ActiveBuyThreads = ActiveBuyThreads + 1
    local bought = 0
    local delay = TraderSettings.TurboMode and 0 or TraderSettings.UnitDelay
    for i = 1, (item.Stock or 0) do
        if not TraderSettings.AutoBuyEnabled then break end
        local ok = pcall(function() BuyTraderRemote:FireServer(item.Name) end)
        if ok then
            bought = bought + 1
            TraderBought = TraderBought + 1
            if item.Price then TraderSpent = TraderSpent + item.Price end
        end
        if delay > 0 then task.wait(delay) end
    end
    if bought > 0 then AddLog(string.format("🛒 %s x%d", item.Name, bought), Color3.fromRGB(100,255,100)) end
    ActiveBuyThreads = ActiveBuyThreads - 1
end

local function AutoBuyItems()
    if not TraderAvailable or isBuyingTrader or not TraderSettings.AutoBuyEnabled then return end
    isBuyingTrader = true
    local ok, stockData = pcall(function() return GetStock:InvokeServer() end)
    if ok and stockData and stockData.Items then
        ItemListCache = stockData.Items
        for _, item in ipairs(stockData.Items) do
            if ItemEnabled[item.Name]==nil then ItemEnabled[item.Name]=true end
        end
        for _, item in ipairs(SortTraderItems(stockData.Items)) do
            if not TraderSettings.AutoBuyEnabled then break end
            if ItemEnabled[item.Name]~=false and item.Stock and item.Stock>0 then
                task.spawn(BuyItemUnits, item)
            end
        end
    else
        AddLog("⚠️ ดึง Stock ไม่สำเร็จ", Color3.fromRGB(255,150,50))
    end
    isBuyingTrader = false
end

if TraderAvailable then
    workspace:GetAttributeChangedSignal("TraderEventActive"):Connect(function()
        if workspace:GetAttribute("TraderEventActive")==true and TraderSettings.AutoBuyEnabled then
            task.spawn(function()
                task.wait(1)
                while workspace:GetAttribute("TraderEventActive")==true and TraderSettings.AutoBuyEnabled do
                    AutoBuyItems()
                    task.wait(TraderSettings.RecheckInterval)
                end
            end)
        end
    end)
end

